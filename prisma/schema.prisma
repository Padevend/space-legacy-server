generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// ENUMS
// ======================================================

enum MissionStatus {
  PLANNED
  ACTIVE
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  UNKNOWN
}

enum EquipmentType {
  SPACECRAFT
  LANDER
  ROVER
  ORBITER
  MODULE
  STAGE
  SCIENTIFIC_INSTRUMENT
  COMPONENT
  ARTIFACT
  OTHER
}

enum OperationalStatus {
  OPERATIONAL
  INACTIVE
  MISSION_ENDED
  FAILED
  UNKNOWN
}

enum PhysicalStatus {
  LEFT_ON_SURFACE
  IN_ORBIT
  RETURNED_TO_EARTH
  DESTROYED
  LOST
  UNKNOWN
}

enum EventType {
  LAUNCH
  LANDING
  FLYBY
  ORBIT_INSERTION
  DEPLOYMENT
  ACTIVATION
  SCIENTIFIC_DISCOVERY
  COMMUNICATION
  LAST_SIGNAL
  MISSION_END
  OTHER
}

enum DatePrecision {
  EXACT
  ESTIMATED
  YEAR_ONLY
  MONTH_ONLY
  UNKNOWN
}

enum CelestialBodyType {
  STAR
  PLANET
  MOON
  ASTEROID
  DWARF_PLANET
  COMET
  OTHER
}

enum LocationType {
  LAUNCH_SITE
  LANDING_SITE
  SURFACE_LOCATION
  ORBIT
  SPACE_REGION
  FACILITY
  OTHER
}

enum SourceType {
  OFFICIAL_DOCUMENT
  SCIENTIFIC_PAPER
  NASA_WEBPAGE
  DATASET
  BOOK
  ARTICLE
  VIDEO
  OTHER
}

enum StoryType {
  LEGACY_STORY
  BEHIND_THE_TECHNOLOGY
  FINAL_CHAPTER
  SPACE_FACT
}

enum PublicationStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

// ======================================================
// CORE MODELS
// ======================================================

// module: missions
model Mission {
  missionId     String        @id @default(uuid()) @db.Uuid
  name          String
  slug          String        @unique
  description   String?       @db.Text
  agency        String?
  missionStatus MissionStatus @default(UNKNOWN)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  equipment     MissionEquipment[]
  events        Event[]
  stories       StoryMission[]
  sources       MissionSource[]

  @@index([name])
  @@index([missionStatus])
  @@map("missions")
}

// module: equipment
model Equipment {
  equipmentId       String            @id @default(uuid()) @db.Uuid
  parentEquipmentId String?           @db.Uuid

  name              String
  slug              String            @unique
  description       String?           @db.Text
  equipmentType     EquipmentType
  manufacturer      String?

  operationalStatus OperationalStatus @default(UNKNOWN)
  physicalStatus    PhysicalStatus    @default(UNKNOWN)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Recursive parent-child relationship
  parent            Equipment?        @relation("EquipmentHierarchy", fields: [parentEquipmentId], references: [equipmentId], onDelete: Restrict)
  children          Equipment[]       @relation("EquipmentHierarchy")

  missions          MissionEquipment[]
  events            EventEquipment[]
  locations         EquipmentLocation[]
  stories           StoryEquipment[]
  sources           EquipmentSource[]

  @@index([name])
  @@index([equipmentType])
  @@index([parentEquipmentId])
  @@index([operationalStatus])
  @@index([physicalStatus])
  @@map("equipments")
}

// module: events
model Event {
  eventId       String        @id @default(uuid()) @db.Uuid
  missionId     String        @db.Uuid

  title         String
  description   String?       @db.Text
  eventType     EventType

  eventDate     DateTime?     @db.Date
  eventTime     DateTime?     @db.Time(0)
  timeStandard  String?
  datePrecision DatePrecision @default(UNKNOWN)
  isEstimated   Boolean       @default(false)
  sequenceOrder Int           @default(0)

  createdAt     DateTime      @default(now())

  mission       Mission       @relation(fields: [missionId], references: [missionId], onDelete: Restrict)

  equipment     EventEquipment[]
  locations     EventLocation[]
  stories       StoryEvent[]
  sources       EventSource[]

  @@index([missionId])
  @@index([eventDate])
  @@index([eventType])
  @@index([sequenceOrder])
  @@map("events")
}

// module: celestial_bodies
model CelestialBody {
  celestialBodyId String            @id @default(uuid()) @db.Uuid
  name            String            @unique
  bodyType        CelestialBodyType
  description     String?           @db.Text

  locations       Location[]

  @@map("celestial_bodies")
}

// module: locations
model Location {
  locationId      String       @id @default(uuid()) @db.Uuid
  celestialBodyId String?      @db.Uuid

  name            String
  locationType    LocationType

  latitude        Decimal?     @db.Decimal(10, 7)
  longitude       Decimal?     @db.Decimal(10, 7)
  altitude        Decimal?     @db.Decimal(14, 4)
  referenceSystem String?
  description     String?      @db.Text

  celestialBody   CelestialBody? @relation(fields: [celestialBodyId], references: [celestialBodyId], onDelete: SetNull)

  events          EventLocation[]
  equipments      EquipmentLocation[]

  @@index([celestialBodyId])
  @@index([name])
  @@map("locations")
}

// ======================================================
// DOCUMENTATION AND TRACEABILITY
// ======================================================

// module: sources
model Source {
  sourceId        String     @id @default(uuid()) @db.Uuid

  title           String
  url             String
  publisher       String
  author          String?
  publicationDate DateTime?  @db.Date
  sourceType      SourceType
  accessedAt      DateTime   @default(now())

  missions        MissionSource[]
  equipments      EquipmentSource[]
  events          EventSource[]
  stories         StorySource[]

  @@unique([url])
  @@index([sourceType])
  @@index([publisher])
  @@map("sources")
}

// ======================================================
// EDITORIAL CONTENT
// ======================================================

// module: stories
model Story {
  storyId           String            @id @default(uuid()) @db.Uuid

  title             String
  slug              String            @unique
  hook              String?           @db.Text
  content           String            @db.Text

  storyType         StoryType
  durationSeconds   Int?
  language          String            @default("en")
  publicationStatus PublicationStatus @default(DRAFT)

  publishedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  missions          StoryMission[]
  equipments        StoryEquipment[]
  events            StoryEvent[]
  sources           StorySource[]

  @@index([storyType])
  @@index([publicationStatus])
  @@index([language])
  @@map("stories")
}

// ======================================================
// MISSION ASSOCIATIONS
// ======================================================

// module: missions
model MissionEquipment {
  missionId                String @db.Uuid
  equipmentId              String @db.Uuid

  missionRole              String
  participationDescription String? @db.Text

  mission                  Mission   @relation(fields: [missionId], references: [missionId], onDelete: Cascade)
  equipment                Equipment @relation(fields: [equipmentId], references: [equipmentId], onDelete: Cascade)

  @@id([missionId, equipmentId])
  @@index([equipmentId])
  @@map("mission_equipments")
}

// module: sources
model MissionSource {
  missionId        String  @db.Uuid
  sourceId         String  @db.Uuid
  claimDescription String? @db.Text

  mission          Mission @relation(fields: [missionId], references: [missionId], onDelete: Cascade)
  source           Source  @relation(fields: [sourceId], references: [sourceId], onDelete: Cascade)

  @@id([missionId, sourceId])
  @@index([sourceId])
  @@map("mission_sources")
}

// ======================================================
// EQUIPMENT ASSOCIATIONS
// ======================================================

// module: events
model EventEquipment {
  eventId     String  @db.Uuid
  equipmentId String  @db.Uuid

  roleInEvent String?
  description String? @db.Text

  event       Event     @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [equipmentId], onDelete: Cascade)

  @@id([eventId, equipmentId])
  @@index([equipmentId])
  @@map("event_equipments")
}

// module: locations
model EquipmentLocation {
  equipmentLocationId String        @id @default(uuid()) @db.Uuid
  equipmentId         String        @db.Uuid
  locationId          String        @db.Uuid

  startDate           DateTime?     @db.Date
  endDate             DateTime?     @db.Date
  locationPrecision   DatePrecision @default(UNKNOWN)

  equipment           Equipment     @relation(fields: [equipmentId], references: [equipmentId], onDelete: Cascade)
  location            Location      @relation(fields: [locationId], references: [locationId], onDelete: Cascade)

  @@unique([equipmentId, locationId, startDate])
  @@index([locationId])
  @@map("equipment_locations")
}

// module: sources
model EquipmentSource {
  equipmentId      String  @db.Uuid
  sourceId         String  @db.Uuid
  claimDescription String? @db.Text

  equipment        Equipment @relation(fields: [equipmentId], references: [equipmentId], onDelete: Cascade)
  source           Source    @relation(fields: [sourceId], references: [sourceId], onDelete: Cascade)

  @@id([equipmentId, sourceId])
  @@index([sourceId])
  @@map("equipment_sources")
}

// ======================================================
// EVENT ASSOCIATIONS
// ======================================================

// module: events
model EventLocation {
  eventId       String   @db.Uuid
  locationId    String   @db.Uuid

  locationRole  String?
  sequenceOrder Int      @default(0)

  event         Event    @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  location      Location @relation(fields: [locationId], references: [locationId], onDelete: Cascade)

  @@id([eventId, locationId])
  @@index([locationId])
  @@map("event_locations")
}

// module: sources
model EventSource {
  eventId          String  @db.Uuid
  sourceId         String  @db.Uuid
  claimDescription String? @db.Text

  event            Event   @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  source           Source  @relation(fields: [sourceId], references: [sourceId], onDelete: Cascade)

  @@id([eventId, sourceId])
  @@index([sourceId])
  @@map("event_sources")
}

// ======================================================
// STORY ASSOCIATIONS
// ======================================================

// module: stories
model StoryMission {
  storyId      String  @db.Uuid
  missionId    String  @db.Uuid
  displayOrder Int     @default(0)

  story        Story   @relation(fields: [storyId], references: [storyId], onDelete: Cascade)
  mission      Mission @relation(fields: [missionId], references: [missionId], onDelete: Cascade)

  @@id([storyId, missionId])
  @@index([missionId])
  @@map("story_missions")
}

// module: stories
model StoryEquipment {
  storyId       String    @db.Uuid
  equipmentId   String    @db.Uuid

  displayOrder  Int       @default(0)
  narrativeRole String?

  story         Story     @relation(fields: [storyId], references: [storyId], onDelete: Cascade)
  equipment     Equipment @relation(fields: [equipmentId], references: [equipmentId], onDelete: Cascade)

  @@id([storyId, equipmentId])
  @@index([equipmentId])
  @@map("story_equipments")
}

// module: stories
model StoryEvent {
  storyId      String @db.Uuid
  eventId      String @db.Uuid
  displayOrder Int    @default(0)

  story        Story  @relation(fields: [storyId], references: [storyId], onDelete: Cascade)
  event        Event  @relation(fields: [eventId], references: [eventId], onDelete: Cascade)

  @@id([storyId, eventId])
  @@index([eventId])
  @@map("story_events")
}

// module: stories
model StorySource {
  storyId          String  @db.Uuid
  sourceId         String  @db.Uuid

  claimDescription String? @db.Text
  displayOrder     Int     @default(0)

  story            Story   @relation(fields: [storyId], references: [storyId], onDelete: Cascade)
  source           Source  @relation(fields: [sourceId], references: [sourceId], onDelete: Cascade)

  @@id([storyId, sourceId])
  @@index([sourceId])
  @@map("story_sources")
}

// ======================================================
// ADDITIVE MODELS (AUTH, RBAC, INGESTION)
// ======================================================

enum UserRole {
  ADMIN
  EDITOR
}

// module: auth
model User {
  userId           String         @id @default(uuid()) @db.Uuid
  email            String         @unique
  passwordHash     String
  role             UserRole       @default(EDITOR)
  isActive         Boolean        @default(true)
  failedLoginCount Int            @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  refreshTokens    RefreshToken[]

  @@index([email])
  @@map("users")
}

// module: auth
model RefreshToken {
  refreshTokenId String    @id @default(uuid()) @db.Uuid
  tokenHash      String    @unique
  userId         String    @db.Uuid
  familyId       String    @db.Uuid
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedById   String?   @db.Uuid
  userAgentHash  String?
  createdAt      DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum IngestionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// module: ingestion
model IngestionRun {
  ingestionRunId String          @id @default(uuid()) @db.Uuid
  status         IngestionStatus @default(PENDING)
  countsSummary  Json?           @db.JsonB
  errorSummary   String?         @db.Text
  dryRun         Boolean         @default(false)
  contentHash    String?
  startedAt      DateTime        @default(now())
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("ingestion_runs")
}
