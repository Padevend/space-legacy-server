{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "rootDir": "./",
    "outDir": "./build",
    "types": ["node"],
    "paths": {
      "#modules/*": ["./app/modules/*"],
      "#contracts/*": ["./app/contracts/*"],
      "#infrastructure/*": ["./app/infrastructure/*"],
      "#middleware/*": ["./app/middleware/*"],
      "#exceptions/*": ["./app/exceptions/*"],
      "#shared/*": ["./app/shared/*"],
      "#config/*": ["./config/*"],
      "#start/*": ["./start/*"],
      "#providers/*": ["./providers/*"],
      "#commands/*": ["./commands/*"],
      "#database/*": ["./database/*"],
      "#tests/*": ["./tests/*"]
    }
  },
  "include": [
    "api/**/*",
    "app/**/*",
    "bin/**/*",
    "commands/**/*",
    "config/**/*",
    "start/**/*",
    "providers/**/*",
    "tests/**/*",
    "prisma/**/*",
    "ace.ts",
    "adonisrc.ts"
  ],
  "exclude": ["node_modules", "build", "dist", "legacy"]
}
