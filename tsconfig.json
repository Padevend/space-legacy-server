{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "types": ["node"]
  },
  "include": [
    "src/**/*",
    "bin/**/*",
    "commands/**/*",
    "config/**/*",
    "start/**/*",
    "tests/**/*",
    "prisma/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
